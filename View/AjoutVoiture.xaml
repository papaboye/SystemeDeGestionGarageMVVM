<Window x:Class="TravailPratique2.View.AjoutVoiture"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TravailPratique2.View"
        mc:Ignorable="d"
        Title="Ajouter une voiture" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        
        <Label Grid.Row="0" Grid.Column="0" Content="Marque :" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtmarque" Margin="5" />
        
        <Label Grid.Row="1" Grid.Column="0" Content="Modèle :" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtmodele" Margin="5" />
        
        <Label Grid.Row="2" Grid.Column="0" Content="Annee :" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtannee" Margin="5" />
        
        <Label Grid.Row="3" Grid.Column="0" Content="Categorie :" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtcategorie" Margin="5" />
        
        <Label Grid.Row="4" Grid.Column="0" Content="Prix :" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtprix" Margin="5" />
        
        <Label Grid.Row="2" Grid.Column="2" Content="Vin :" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtvin" Margin="5" />
        
        <Label Grid.Row="3" Grid.Column="2" Content="Proprietaire :" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtproprietaire" Margin="5" />
        
        <Label Grid.Row="4" Grid.Column="2" Content="Date Achat :" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtdatea" Margin="5" />
        
        <Label Grid.Row="5" Grid.Column="2" Content="Derniere Revision:" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="3" x:Name="txtdater" Margin="5" />
        
        <Label Grid.Row="6" Grid.Column="2" Content="Garantie :" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="3" x:Name="txtgarantie" Margin="5" />
        
         <Label Grid.Row="7" Grid.Column="2" Content="Assurance :" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="3" x:Name="txtassurance" Margin="5" />

        <Label Grid.Row="5" Grid.Column="0" Content="Kilometrage :" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtkilometrage" Margin="5" />
        
        <Label Grid.Row="6" Grid.Column="0" Content="Type de carburant :" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txttc" Margin="5" />
        
        <Label Grid.Row="7" Grid.Column="0" Content="Couleur :" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtcouleur" Margin="5" />

        <Label Grid.Row="1" Grid.Column="2" Content="État :" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtetat" Margin="5" />
            
        
        <Label Grid.Row="0" Grid.Column="2" Content="Transmission :" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txttransmission" Margin="5" />

        <Button Grid.Row="8" Grid.ColumnSpan="4" Content="Ajouter la voiture" Click="AjouterVoiture_Click"
                Height="40" Margin="5" HorizontalAlignment="Center" Width="200" />
    </Grid>
</Window>
