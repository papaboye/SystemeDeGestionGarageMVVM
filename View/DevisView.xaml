<Window x:Class="TravailPratique2.View.DevisView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TravailPratique2.View"
        mc:Ignorable="d"
        Title="Validation du devis" Height="360" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel>
            <TextBlock Text="Détails du devis" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
            <TextBlock Text="{Binding description}" Margin="0,5" TextWrapping="Wrap"/>
            <TextBlock Text="Total estimé :" />
            <TextBlock Text="{Binding Total}" FontWeight="Bold" FontSize="14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Valider le devis" Click="Valider_Click" Margin="10"/>
                <Button Content="Annuler" Click="Annuler_Click" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
