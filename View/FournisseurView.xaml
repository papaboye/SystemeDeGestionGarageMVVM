<Window x:Class="TravailPratique2.View.FournisseurView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TravailPratique2.View"
        mc:Ignorable="d"
        Title="Gestion de garage — Fournisseur" Height="520" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>
           
            <TabItem Header="Stock Voitures">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Approvisionner le stock" Width="200" Margin="0,0,10,0" Click="AjouterVoiture_Click"/>
                        
                    </StackPanel>
                    <DataGrid Grid.Row="1"  ItemsSource="{Binding Voitures}" AutoGenerateColumns="False" HeadersVisibility="Column"
                               IsReadOnly="True"
                               Background="White" BorderBrush="#DDD" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Marque" Binding="{Binding marque}"/>
                            <DataGridTextColumn Header="Modèle" Binding="{Binding modele}"/>
                            <DataGridTextColumn Header="Année" Binding="{Binding annee}"/>
                            <DataGridTextColumn Header="Categorie" Binding="{Binding categorie}"/>
                            <DataGridTextColumn Header="Prix" Binding="{Binding prixAproximatif}"/>
                            <DataGridTextColumn Header="Carburant" Binding="{Binding typeCarburant}"/>
                            <DataGridTextColumn Header="Kilometrage" Binding="{Binding kilometrage}"/>
                            <DataGridTextColumn Header="Couleur" Binding="{Binding couleur}"/>
                            <DataGridTextColumn Header="Transmission" Binding="{Binding transmission}"/>
                            <DataGridTextColumn Header="Vin" Binding="{Binding vin}"/>
                            <DataGridTextColumn Header="Proprietaire" Binding="{Binding proprietaireActuel}"/>
                            <DataGridTextColumn Header="État" Binding="{Binding etatGeneral}"/>
                            <DataGridTextColumn Header="Date Achat" Binding="{Binding dateAchat}"/>
                            <DataGridTextColumn Header="Revision" Binding="{Binding derniereRevision}"/>
                            <DataGridTextColumn Header="Garantie" Binding="{Binding garantitRestant}"/>
                            <DataGridTextColumn Header="Assurance" Binding="{Binding assurance}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Stock Piece">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">

                        <Button Content="Approvisionner les pièces" Click="AjouterPiece_Click" Width="200" Margin="0,0,10,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Pieces}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False" Background="White" BorderBrush="#DDD" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom Piece" Binding="{Binding nom_de_piece}"/>
                            <DataGridTextColumn Header="Prix Approximatif" Binding="{Binding prix_approx}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
