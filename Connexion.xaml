<Window x:Class="TravailPratique2.Connexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TravailPratique2"
        mc:Ignorable="d"
        Title="Connexion" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Height="30" Margin="5,5,5,5" VerticalContentAlignment="Center" Content="Votre Username" Grid.Row="0" Grid.Column="0" />
        <Label Height="30" Margin="5,5,5,5" VerticalContentAlignment="Center" Content="Votre Password" Grid.Row="1" Grid.Column="0" />
        <Label Height="30" Margin="5,5,5,5" VerticalContentAlignment="Center" Content="Votre Role" Grid.Row="2" Grid.Column="0" />
        <TextBox Padding="2,2,2,2" VerticalContentAlignment="Center" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="5,5,5,5" Grid.Row="0" Grid.Column="1" />
        <TextBox Padding="2,2,2,2" VerticalContentAlignment="Center" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="5,5,5,5" Grid.Row="1" Grid.Column="1" />
        <ComboBox VerticalContentAlignment="Center" SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Roles}" Height="30" Margin="5,5,5,5" Grid.Row="2" Grid.Column="1" />
        <Button Command="{Binding ConnexionCommand}" Height="30" Margin="5,5,5,5" Content="SeConnecter" Grid.Row="3" Grid.Column="1" />

    </Grid>
</Window>
