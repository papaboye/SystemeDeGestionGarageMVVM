<Window x:Class="TravailPratique2.Connexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garage Management — Connexion"
        Height="420"
        Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    <Grid>
        <Border Width="420"
                Padding="32"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Gestion de garage"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Connectez-vous à votre espace"
                           Margin="0,6,0,28"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Nom d'utilisateur"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         Padding="10,6"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Mot de passe"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordInput"
                             Height="38"
                             Padding="10,6"
                             Margin="0,0,0,20"/>

                <Button Content="Se connecter"
                        Command="{Binding ConnexionCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,16,0,0"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
